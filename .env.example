# O2H Environment Configuration

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database (Local MySQL for development)
DATABASE_URL="mysql://root:@localhost:3306/o2h_chat"

# Database (Neon PostgreSQL for production)
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/o2h_chat?sslmode=require"

# JWT
JWT_SECRET=o2h_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=o2h_refresh_token_secret_2026
JWT_REFRESH_EXPIRES_IN=30d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Storage (local | minio | s3)
STORAGE_TYPE=local

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
