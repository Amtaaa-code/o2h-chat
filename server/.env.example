# O2H Backend Environment Configuration

# Server
NODE_ENV=production
PORT=5000
API_URL=https://o2h-backend.onrender.com
CLIENT_URL=https://o2h-frontend.onrender.com

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/o2h_chat?sslmode=require"

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Storage (local)
STORAGE_TYPE=local
